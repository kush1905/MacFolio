# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override (default tries gemini-3.6-flash, then gemini-3.5-flash, …)
# GEMINI_MODEL=gemini-3.6-flash

# Optional: GitHub token for contribution calendars (otherwise public HTML is used)
# GITHUB_TOKEN=

# Postgres (docker compose up -d)
DATABASE_URL=postgres://macfolio:macfolio@localhost:5433/macfolio

# Ask Kush (primary). Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional override (default tries openai/gpt-oss-120b, openai/gpt-oss-20b, then qwen/qwen3.8-27b)
# GROQ_MODEL=

# Contact form delivery via Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Where messages go (defaults to the email in content/about.json)
# CONTACT_TO_EMAIL=
# Verified sender, e.g. "Portfolio <hello@kushgangwal.site>" (defaults to Resend's onboarding sender)
# CONTACT_FROM_EMAIL=
